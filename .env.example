# Copy to .env (FastAPI, from the repo root or apps/api) and to apps/web/.env.local (Next.js).
# Leave OPENAI_API_KEY empty until you have a real key. Do not commit either copy.

# Required for the tutor to stream a reply. The chat route fails with a clear error when this is empty.
OPENAI_API_KEY=

# Optional. The Next.js route uses gpt-4o-mini when this is unset.
OPENAI_MODEL=gpt-4o-mini

# FastAPI. Matches docker-compose.yml.
DATABASE_URL=postgresql+psycopg://aitutor:aitutor@localhost:5432/aitutor

# Next.js server calls FastAPI with API_URL. The browser uses NEXT_PUBLIC_API_URL.
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
